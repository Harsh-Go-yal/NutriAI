# Secrets -- never commit. Copy backend/.env.example to backend/.env instead.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
*.egg-info/

# Databases -- contain real user data (phone numbers, food logs)
*.db
*.db.bak*
*.sqlite
*.sqlite3

# Node
node_modules/
dist/
build/
.vite/

# Raw source dataset -- regenerated by scripts/build_ifct.py; the built
# ifct2017.json IS committed because it is what the app loads.
backend/app/data/ifct_raw.csv

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Scratch
_patch*.py
_gendoc.py
