# Copy to backend/.env and fill in. Never commit backend/.env.

# ── LLM (OpenAI) ────────────────────────────────────────────────────────────
# Only the vision agent and qualitative commentary use the model. Every
# nutrient number comes from IFCT 2017 / USDA, never from the LLM.
OPENAI_API_KEY=
DIET_PLANNER_MODEL=gpt-4o-mini
RECOMMENDATION_MODEL=gpt-4o-mini
FOOD_VISION_MODEL=gpt-4o
PROFILE_HEALTH_MODEL=gpt-4o-mini
PROGRESS_MODEL=gpt-4o-mini

# ── Database ────────────────────────────────────────────────────────────────
# SQLite needs no setup and is fine for development.
DATABASE_URL=sqlite:///./nutrition_ai.db
# For Postgres (docker-compose uses this):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nutrition_ai
REDIS_URL=redis://localhost:6379/0

# ── USDA FoodData Central (fallback nutrient source) ───────────────────────
# DEMO_KEY works without signup but is capped at 30 requests/hour.
# Free key: https://api.data.gov/signup/
USDA_API_KEY=DEMO_KEY

# ── Sarvam Voice Agents (optional -- outbound phone calls) ─────────────────
# Two separate credentials; they are not interchangeable.
#   SARVAM_API_KEY        -> core STT/TTS/translate (api-subscription-key header)
#   SARVAM_VOICE_API_KEY  -> Voice Agents / outbound  (X-API-Key header)
SARVAM_API_KEY=
SARVAM_VOICE_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_AGENT_ID=
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_FROM_NUMBER=

# Shared secret the voice agent presents on every tool call (X-Agent-Key).
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(24))"
# Leave empty to disable the agent tool endpoints entirely (they fail closed).
AGENT_TOOL_KEY=

# ── Messaging (optional) ────────────────────────────────────────────────────
# Telegram is the ~5 minute option: @BotFather -> /newbot -> token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Twilio (WhatsApp sandbox / SMS). Production WhatsApp needs Meta verification.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
